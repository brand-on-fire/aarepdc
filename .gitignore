*.3gp
*.mp4
*.mpeg
*.mpg
*.mov
*.webm
*.flv
*.m4v
*.mng
*.asx
*.asf
*.wmv
*.avi

# ============================================================
# DB backups — local only, never commit (contain PII)
# ============================================================
db-backups/

