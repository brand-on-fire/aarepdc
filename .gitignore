# ============================================================
# WordPress Core — WP Engine auto-updates these, don't track
# ============================================================
wp-admin/
wp-includes/
index.php
wp-activate.php
wp-blog-header.php
wp-comments-post.php
wp-cron.php
wp-links-opml.php
